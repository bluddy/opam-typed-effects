opam-version: "2.0"
name: "miou"
version: "0.10.1+typed-effects"
synopsis: "Composable concurrency primitives for OCaml (typed-effects compatible)"
description: """\
Miou is a simple scheduler for OCaml 5 with typed effects.
It supports cooperative multi-threading and parallelism with domains,
updated to work with the typed effects compiler and stdlib_v2."""
maintainer: "Romain Calascibetta <romain.calascibetta@gmail.com>"
authors: "Romain Calascibetta <romain.calascibetta@gmail.com>"
license: "MIT"
homepage: "https://github.com/robur-coop/miou"
doc: "https://docs.osau.re/local/miou/"
bug-reports: "https://github.com/robur-coop/miou/issues"
dev-repo: "git+https://github.com/bluddy/miou.git"

depends: [
  "ocaml"             {>= "5.2.0"}
  "dune"              {>= "3.15.0"}
  "dune-configurator"
  "stdlib_v2"
  "fmt"               {with-test}
]

build: [ "dune" "build" "-p" name "-j" jobs ]
run-test: [ "dune" "runtest" "-p" name "-j" jobs ]

url {
  src: "git+https://github.com/bluddy/miou.git#typed-effects"
}
