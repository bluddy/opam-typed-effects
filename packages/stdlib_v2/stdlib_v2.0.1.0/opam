homepage: "https://github.com/bluddy/stdlib-v2"
bug-reports: "https://github.com/bluddy/stdlib-v2/issues"
dev-repo: "git+https://github.com/bluddy/stdlib-v2.git"
depends: [
  "ocaml" {>= "5.6.0"}
  "dune" {>= "3.14"}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
  ]
]
