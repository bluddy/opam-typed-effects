opam-version: "2.0"
name: "stdlib_v2"
version: "0.1.0"
synopsis: "Effect-polymorphic standard library overlay for OCaml with typed effects"
description: """\
An overlay for the OCaml standard library providing effect-polymorphic
higher-order functions while maintaining 100% compatibility with pure code."""
